# Paper build. Run from paper/ (or `make -C paper <target>` from the repo root).
#   make / make agent   AGENT 2027 profile (8 pp incl. refs, names shown)  -> build/main-agent.pdf
#   make icrito         ICRITO 2027 profile (6 pp incl. refs, anonymized)  -> build/main-icrito.pdf
#   make final          AGENT build where MISSING/CONFIRM/CITEPENDING/TODO are hard errors
#   make check          build + check AGENT (8 pp); `make check VENUE=icrito` for ICRITO (6 pp)
#   make check-all      build + check both venues
#   make lint           source-only checks (citations, banned words, typed numbers, venue switches)
# Prefer the project venv (repo root .venv) so the right python runs regardless of PATH.
PYTHON ?= $(if $(wildcard ../.venv/bin/python),../.venv/bin/python,python3)
VENUE ?= agent
# MacTeX installs its binaries in /Library/TeX/texbin, which non-login shells may not have on PATH.
export PATH := $(if $(wildcard /Library/TeX/texbin),/Library/TeX/texbin:,)$(PATH)
LATEXMK ?= latexmk
FIG_SRC := ../results/case_study/figures/fig1_timeline.pdf

.PHONY: agent icrito final build check check-all lint clean prereqs
agent:
	@$(MAKE) --no-print-directory build VENUE=agent ANON=false ICRITO=false FINAL=false LIMIT=8
icrito:
	@$(MAKE) --no-print-directory build VENUE=icrito ANON=true ICRITO=true FINAL=false LIMIT=6
final:
	@$(MAKE) --no-print-directory build VENUE=agent ANON=false ICRITO=false FINAL=true LIMIT=8

prereqs:
	@test -f IEEEtran.cls || kpsewhich IEEEtran.cls >/dev/null 2>&1 || { echo "IEEEtran.cls not found. Install the IEEEtran class (MacTeX/TeX Live: package 'ieeetran'; Debian/Ubuntu: texlive-publishers)."; exit 1; }
	@command -v pdfinfo >/dev/null || { echo "poppler (pdfinfo/pdffonts/pdftotext) not found: brew install poppler"; exit 1; }

build: prereqs
	@mkdir -p build figs
	@printf '%% Generated by paper/Makefile. Do not edit.\n\\newif\\ifanon\\anon$(ANON)\n\\newif\\ificrito\\icrito$(ICRITO)\n\\newif\\iffinal\\final$(FINAL)\n\\newcommand{\\PageLimit}{$(LIMIT)}\n' > venue.tex
	@$(PYTHON) ../scripts/collect_macros.py --paper .
	@cp $(FIG_SRC) figs/fig1_timeline.pdf
	$(LATEXMK) -pdf -interaction=nonstopmode -halt-on-error -outdir=build -jobname=main-$(VENUE)$(if $(filter true,$(FINAL)),-final) main.tex
	@echo "built build/main-$(VENUE)$(if $(filter true,$(FINAL)),-final).pdf"

# Always builds the venue it checks, so the page limit can never come from a stale build.
check:
	@$(MAKE) --no-print-directory $(VENUE) >/dev/null
	@$(PYTHON) ../scripts/paper_check.py check --paper . --venue $(VENUE) --pdf build/main-$(VENUE).pdf

check-all:
	@$(MAKE) --no-print-directory check VENUE=agent
	@$(MAKE) --no-print-directory check VENUE=icrito

lint:
	@$(PYTHON) ../scripts/paper_check.py lint --paper .

clean:
	@$(LATEXMK) -C -outdir=build -jobname=main-agent main.tex >/dev/null 2>&1 || true
	@rm -rf build venue.tex macros-generated.tex figs/fig1_timeline.pdf
